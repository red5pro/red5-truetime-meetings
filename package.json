{
  "name": "red5-truetime-meetings",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx scripts/generate-build-info.ts && vite",
    "build": "npx tsx scripts/generate-build-info.ts && vite build",
    "build:docker": "npx tsx scripts/generate-build-info.ts && env-cmd -f .env.docker vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "npx tsx scripts/generate-build-info.ts && vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/lib-storage": "^3.1134.0",
    "@charkour/react-reactions": "^0.11.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@mui/icons-material": "^6.2.0",
    "@mui/material": "^6.2.0",
    "@mui/styles": "^6.4.8",
    "@react-oauth/google": "^0.13.5",
    "emoji-picker-react": "^4.22.2",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "loglevel": "^1.9.2",
    "lottie-react": "^3.1.2",
    "mediabunny": "^1.57.0",
    "nanoid": "^6.0.1",
    "notistack": "^3.0.2",
    "pubnub": "^13.0.1",
    "react": "^19.3.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "red5pro-conference-sdk": "^1.0.8",
    "red5pro-webrtc-sdk": "^16.0.0",
    "slick-carousel": "^2.0.0",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
